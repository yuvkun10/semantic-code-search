{
  "name": "semantic-code-search",
  "version": "0.1.0",
  "description": "A TypeScript CLI for semantic and code-token hybrid search over local repositories.",
  "type": "module",
  "bin": {
    "semantic-code-search": "./dist/cli.js",
    "scs": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "deps:audit": "npm audit --audit-level=moderate",
    "deps:outdated": "npm outdated",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "ignore": "^7.0.5",
    "openai": "^6.39.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
